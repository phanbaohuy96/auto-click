<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>editor.load_issues</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@scenarios@</string>
		<key>scenarios</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>%d 件のシナリオに問題があります</string>
		</dict>
	</dict>
	<key>panel.gestures</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@gestures@</string>
		<key>gestures</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>%d 件の操作</string>
		</dict>
	</dict>
	<key>record.finished</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@steps@</string>
		<key>steps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>%d ステップを記録しました。</string>
		</dict>
	</dict>
	<key>record.in_progress</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@gestures@</string>
		<key>gestures</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>%d 件の操作を記録中 — ⌥⌘R で終了</string>
		</dict>
	</dict>
	<key>record.warning.multiple_applications</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@applications@</string>
		<key>applications</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>この記録は %d 個のアプリにまたがるため絶対座標を使います。ウインドウが動くとステップはずれます。</string>
		</dict>
	</dict>
	<key>run.completed.iterations</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@loops@</string>
		<key>loops</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>%d 周完了</string>
		</dict>
	</dict>
	<key>run.completed.steps</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@steps@</string>
		<key>steps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>%d ステップ完了</string>
		</dict>
	</dict>
	<key>run.countdown</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@seconds@</string>
		<key>seconds</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>%d 秒後に開始…</string>
		</dict>
	</dict>
	<key>run.start</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@seconds@</string>
		<key>seconds</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>%d 秒後に開始</string>
		</dict>
	</dict>
	<key>scenario.summary.loops</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@loops@</string>
		<key>loops</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>%d 周</string>
		</dict>
	</dict>
	<key>scenario.summary.steps</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@steps@</string>
		<key>steps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>other</key>
			<string>%d ステップ</string>
		</dict>
	</dict>
</dict>
</plist>
