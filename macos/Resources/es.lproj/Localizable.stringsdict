			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>Grabando %d operación — ⌥⌘R para terminar</string>
			<key>other</key>
			<string>Grabando %d operaciones — ⌥⌘R para terminar</string>
		</dict>
	</dict>
	<key>record.warning.multiple_applications</key>
