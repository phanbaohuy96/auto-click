<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Strings carrying a count (LC-9). English inflects for one/other; Vietnamese, Chinese and Japanese do not,
  and their files carry only `other`. The plural rule is chosen with the *active* interface language, not
  with the process locale — see Localization.callAsFunction(_:_:).
-->
<plist version="1.0">
<dict>
    <key>run.start</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@seconds@</string>
        <key>seconds</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>d</string>
            <key>one</key><string>Start in %d second</string>
            <key>other</key><string>Start in %d seconds</string>
        </dict>
    </dict>
    <key>run.countdown</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@seconds@</string>
        <key>seconds</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>d</string>
            <key>one</key><string>Starting in %d second…</string>
            <key>other</key><string>Starting in %d seconds…</string>
        </dict>
    </dict>
    <key>run.completed.steps</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@steps@</string>
        <key>steps</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>d</string>
            <key>one</key><string>Completed %d step</string>
            <key>other</key><string>Completed %d steps</string>
        </dict>
    </dict>
    <key>run.completed.iterations</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@loops@</string>
        <key>loops</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>d</string>
            <key>one</key><string>Completed %d loop</string>
            <key>other</key><string>Completed %d loops</string>
        </dict>
    </dict>
    <key>record.in_progress</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@gestures@</string>
        <key>gestures</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>d</string>
            <key>one</key><string>Recording %d operation — ⌥⌘R to finish</string>
            <key>other</key><string>Recording %d operations — ⌥⌘R to finish</string>
        </dict>
    </dict>
    <key>record.finished</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@steps@</string>
        <key>steps</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>d</string>
            <key>one</key><string>Recorded %d step.</string>
            <key>other</key><string>Recorded %d steps.</string>
        </dict>
    </dict>
    <key>record.warning.multiple_applications</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@applications@</string>
        <key>applications</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>d</string>
            <key>one</key><string>The recording covers %d application, so it uses absolute coordinates; the steps will drift if the window moves.</string>
            <key>other</key><string>The recording spans %d applications, so it uses absolute coordinates; the steps will drift if the window moves.</string>
        </dict>
    </dict>
    <key>panel.gestures</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@gestures@</string>
        <key>gestures</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>d</string>
            <key>one</key><string>%d operation</string>
            <key>other</key><string>%d operations</string>
        </dict>
    </dict>
    <key>scenario.summary.steps</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@steps@</string>
        <key>steps</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>d</string>
            <key>one</key><string>%d step</string>
            <key>other</key><string>%d steps</string>
        </dict>
    </dict>
    <key>scenario.summary.loops</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@loops@</string>
        <key>loops</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>d</string>
            <key>one</key><string>%d loop</string>
            <key>other</key><string>%d loops</string>
        </dict>
    </dict>
    <key>editor.load_issues</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@scenarios@</string>
        <key>scenarios</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>d</string>
            <key>one</key><string>%d scenario has a problem</string>
            <key>other</key><string>%d scenarios have problems</string>
        </dict>
    </dict>
</dict>
</plist>
