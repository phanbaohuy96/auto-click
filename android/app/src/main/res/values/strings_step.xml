<resources>
    <!-- The Step panel (OV-20 to OV-23). Every label is short: the panel sits on top of the
         application being automated, and space taken here is screen the user cannot see. -->
    <string name="step_panel_title">Step %1$d of %2$d</string>
    <string name="step_previous">Previous step</string>
    <string name="step_next">Next step</string>
    <string name="step_move_up">Move earlier</string>
    <string name="step_move_down">Move later</string>
    <string name="step_delete">Delete step</string>
    <string name="step_cancel">Cancel</string>
    <string name="step_save">Save</string>

    <!-- The five Actions (SM-7), named for what they do rather than what they are called in code. -->
    <string name="step_kind_tap">Tap</string>
    <string name="step_kind_swipe">Swipe</string>
    <string name="step_kind_multi_touch">Multi-touch</string>
    <string name="step_kind_global">System</string>
    <string name="step_kind_text">Type</string>

    <string name="step_hold">Hold (ms)</string>
    <string name="step_duration">Duration (ms)</string>
    <string name="step_repeat">Repeat</string>
    <string name="step_delay">Then wait (ms)</string>
    <string name="step_text">Text</string>
    <string name="step_contact">Contact %1$d (ms)</string>
    <string name="step_add_contact">Add contact</string>
    <string name="step_remove_contact">Remove contact %1$d</string>
    <!-- OV-21: points are dragged, never typed, so the panel says where they are edited. -->
    <string name="step_points_hint">Drag the markers on screen to move the points.</string>
    <string name="step_range">%1$d to %2$d</string>

    <string name="global_back">Back</string>
    <string name="global_home">Home</string>
    <string name="global_recents">Recents</string>
    <string name="global_notifications">Notifications</string>
    <string name="global_quick_settings">Quick settings</string>
    <string name="global_lock_screen">Lock screen</string>
    <string name="global_screenshot">Screenshot</string>

    <!-- SM-17: refused at the editor, because a gesture the platform rejects mid-run is a Step
         that silently did nothing. -->
    <string name="violation_too_many_paths">%1$d contacts is more than this device allows (%2$d)</string>
    <string name="violation_too_few_paths">Multi-touch needs at least %1$d contacts</string>
    <string name="violation_duration_too_long">%1$d ms is longer than this device allows (%2$d ms)</string>
    <string name="violation_zero_duration">A swipe needs a duration — zero would be a tap</string>
    <string name="violation_point_outside">The point %1$d, %2$d is off the screen</string>
    <string name="violation_text_too_long">%1$d characters is more than the %2$d allowed</string>
    <!-- OV-35: what the chip row is, and what the chosen Action does. -->
    <string name="step_action_heading">What this step does</string>
    <string name="step_about_tap">Touches one point and lets go.</string>
    <string name="step_about_swipe">Drags from one point to another. Both are markers on screen.</string>
    <string name="step_about_multi_touch">Several points touched at once, like a pinch.</string>
    <string name="step_about_global">Presses a system button: back, home or recents. Touches nothing.</string>
    <string name="step_about_text">Types into whatever field already has the caret. Touches nothing.</string>
    <!-- OV-36: the way back, and the one question asked on the way out. -->
    <string name="step_back_to_scenario">Back to the scenario</string>
    <string name="step_discard_title">Discard these changes?</string>
    <string name="step_discard_message">This step has edits that were never saved. Leaving now loses them.</string>
    <string name="step_discard_confirm">Discard</string>
    <string name="step_discard_dismiss">Keep editing</string>
    <string name="step_try">Try it</string>
</resources>
