<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's mark is the Marker: the thing the user places, drags and aims with. A ring with a dot
  in it is what a tap looks like, and the second, fainter ring outside it is what a repeated one
  looks like — which is the whole product in two shapes.

  Everything sits inside the central 72dp of the 108dp viewport, which is the only part of an
  adaptive icon a launcher promises not to crop.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The repeat: a ring at the edge of the safe zone, faint, and open at the top right so it
         reads as motion rather than as a second target. -->
    <path
        android:pathData="M54,20 A34,34 0 1 1 30,30"
        android:strokeWidth="3"
        android:strokeColor="#59E8B33C"
        android:strokeLineCap="round" />
    <!-- The Marker itself. -->
    <path
        android:pathData="M54,32 A22,22 0 1 1 53.98,32 Z"
        android:strokeWidth="6"
        android:strokeColor="#FFE8B33C" />
    <path
        android:pathData="M54,44 A10,10 0 1 1 53.99,44 Z"
        android:fillColor="#FFE8B33C" />
</vector>
